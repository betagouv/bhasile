NEXT_URL=http://localhost:3000
NEXT_PUBLIC_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
E2E_BASE_URL=http://localhost:3000
DATABASE_URL="postgresql://johndoe:randompassword@localhost:5432/mydb?schema=public"
DATABASE_POOL_MAX=10 # connexions max par process ; voir docs/database.md
PRO_CONNECT_ID="pro-connect-id"
PRO_CONNECT_SECRET="pro-connect-secret"
PRO_CONNECT_BASE_URL="https://pro-connect-base-url.example"
SECRET="secret"
OPERATEUR_PASSWORDS="password,password2"
S3_URL="s3-url"
S3_ACCESS="storage-access"
S3_SECRET="storage-secret"
S3_BUCKET_NAME="bucket-name"
SENTRY_AUTH_TOKEN="sentry-auth-token"
NEXT_PUBLIC_MATOMO_URL="matomo-url"
NEXT_PUBLIC_MATOMO_SITE_ID="matomo-site-id"
AUTH_SECRET="auth-secret" # generate with `openssl rand -base64 32`
SMALL_SEED=1
REPORTING_SCHEMA="reporting"
DOCS_BUCKET_NAME="placedasile-docs"
OFII_CSV_NAME="structures_ofii.csv"
METABASE_SITE_URL="https://your_metabase_url.fr"
METABASE_SECRET_KEY="your_metabase_key"
METABASE_DASHBOARD_ID=1
DEMARCHES_NUMERIQUES_TOKEN="demarches-numeriques-token"
NEXT_PUBLIC_BHASILE_CONTACT_EMAIL="contact@bhasile.beta.gouv.fr"
NEXT_PUBLIC_BHASILE_PHONE_NUMBERS="06 12 34 56 78"
E2E_WORKERS=5 # number of workers for e2e tests
# Uniquement pour tests/e2e-legacy (login ProConnect réel). tests/e2e forge sa session.
E2E_AGENT_EMAIL="your.agent@email.fr"
E2E_AGENT_PASSWORD="your-proconnect-password"
NEXT_PUBLIC_SHOW_RESSOURCES=true
NEXT_PUBLIC_DOCUMENTS_FINANCIERS_OPEN_YEAR=2026
NEXT_PUBLIC_INDICATEUR_FINANCIER_CUTOFF_YEAR_AUTORISEE=2024
NEXT_PUBLIC_INDICATEUR_FINANCIER_CUTOFF_YEAR_SUBVENTIONNEE=2025
NEXT_PUBLIC_AUTORISEE_OPEN_YEAR=2026
NEXT_PUBLIC_SUBVENTIONNEE_OPEN_YEAR=2025
NEXT_PUBLIC_PLACES_VERSIONED_FROM_YEAR=2026
ACTUALISATION_YEAR=2026
CRON_ENABLED=true
IS_PRODUCTION=true 
SKIP_POSTDEPLOY=1 # saute le postdeploy sur un déploiement, ignoré en prod

# Tarifs journaliers cibles par type de structure et zonage (anomalie COUT_JOURNALIER_GT_TARIF_CIBLE).
TARIF_JOURNALIER_CIBLE={"CADA":{"idf":25,"horsIdf":25},"HUDA":{"idf":25,"horsIdf":25},"CPH":{"idf":25,"horsIdf":25},"CAES":{"idf":25,"horsIdf":25}}

# Si besoin on peut émuler la date courante de l'app en local. Laisser vide en prod.
# NEXT_PUBLIC_EMULATED_NOW=2027-03-01T12:00:00Z
