model User {
  id                   Int                           @id @default(autoincrement())
  name                 String?
  email                String                        @unique
  lastConnection       DateTime?
  userActions          UserAction[]
  operateur            Operateur?                    @relation(fields: [operateurId], references: [id], onDelete: Restrict)
  operateurId          Int?
  isSuperAdmin         Boolean                       @default(false)
  perimeter            Perimeter?                    @relation(fields: [perimeterId], references: [id], onDelete: Restrict)
  perimeterId          Int?
  isActivated          Boolean                       @default(false)
  deactivatedAt        DateTime?
  grants               Grant[]
  notes                Note[]
  anomaliesJustifiees  Anomalie[]
  messages             Message[]
  messageReceipts      MessageReceipt[]
  emailNotifications   EmailNotificationRecipient[]
  tarificationEvents   TarificationEvent[]
  tarificationOpenings TarificationDocumentOpening[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@schema("public")
}

model UserAction {
  id          Int                @id @default(autoincrement())
  userId      Int
  user        User               @relation(fields: [userId], references: [id])
  action      UserActionCategory
  structure   Structure?         @relation(fields: [structureId], references: [id])
  structureId Int?
  cpom        Cpom?              @relation(fields: [cpomId], references: [id])
  cpomId      Int?
  operateur   Operateur?         @relation(fields: [operateurId], references: [id])
  operateurId Int?
  type        UserActionType?
  details     Json?

  createdAt DateTime @default(now())

  @@schema("public")
}

enum UserActionCategory {
  CREATE
  READ
  UPDATE
  DELETE

  @@schema("public")
}

enum UserActionType {
  STATISTIQUES_TABLE
  STATISTIQUES_CARTOGRAPHIE
  STRUCTURES_CARTOGRAPHIE
  TYPE_PLACES_SPREADSHEET_EXPORT
  FINANCES_SPREADSHEET_EXPORT
  CONTROLE_QUALITE_SPREADSHEET_EXPORT
  STRUCTURE_SPREADSHEET_EXPORT
  STRUCTURE_PDF_EXPORT
  STATISTIQUES_SPREADSHEET_EXPORT
  STATISTIQUES_PDF_EXPORT

  @@schema("public")
}
