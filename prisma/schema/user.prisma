model User {
  id                  Int           @id @default(autoincrement())
  name                String?
  email               String        @unique
  lastConnection      DateTime
  userActions         UserAction[]
  role                Role?         @relation(fields: [roleId], references: [id])
  roleId              Int?
  emailPattern        EmailPattern? @relation(fields: [emailPatternId], references: [id])
  emailPatternId      Int?
  operateur           Operateur?    @relation(fields: [operateurId], references: [id], onDelete: Restrict)
  operateurId         Int?
  isSuperAdmin        Boolean       @default(false)
  grants              Grant[]
  notes               Note[]
  anomaliesJustifiees Anomalie[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@schema("public")
}

model UserAction {
  id          Int                @id @default(autoincrement())
  userId      Int
  user        User               @relation(fields: [userId], references: [id])
  action      UserActionCategory
  structure   Structure?         @relation(fields: [structureId], references: [id])
  structureId Int?
  cpom        Cpom?              @relation(fields: [cpomId], references: [id])
  cpomId      Int?
  operateur   Operateur?         @relation(fields: [operateurId], references: [id])
  operateurId Int?
  type        UserActionType?
  details     Json?

  createdAt DateTime @default(now())

  @@schema("public")
}

model Role {
  id               Int               @id @default(autoincrement())
  name             String            @unique
  roleDepartements RoleDepartement[]
  users            User[]
  emailPatterns    EmailPattern[]

  @@schema("public")
}

model RoleDepartement {
  departement       Departement @relation(fields: [departementNumero], references: [numero], onDelete: Cascade)
  departementNumero String
  role              Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId            Int

  @@id([departementNumero, roleId])
  @@index([roleId])
  @@schema("public")
}

model EmailPattern {
  id      Int     @id @default(autoincrement())
  pattern String  @unique
  role    Role?   @relation(fields: [roleId], references: [id])
  roleId  Int?
  users   User[]
  grants  Grant[]

  @@schema("public")
}

model Grant {
  id                Int           @id @default(autoincrement())
  user              User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            Int?
  emailPattern      EmailPattern? @relation(fields: [emailPatternId], references: [id], onDelete: Cascade)
  emailPatternId    Int?
  role              AccessRole
  scope             GrantScope
  region            Region?       @relation(fields: [regionId], references: [id], onDelete: Cascade)
  regionId          Int?
  departement       Departement?  @relation(fields: [departementNumero], references: [numero], onDelete: Cascade)
  departementNumero String?
  structure         Structure?    @relation(fields: [structureId], references: [id], onDelete: Cascade)
  structureId       Int?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([emailPatternId])
  @@schema("public")
}

enum AccessRole {
  VIEWER
  EDITEUR
  ADMIN

  @@schema("public")
}

enum GrantScope {
  NATIONAL
  REGION
  DEPARTEMENT
  STRUCTURE

  @@schema("public")
}

enum UserActionCategory {
  CREATE
  READ
  UPDATE
  DELETE

  @@schema("public")
}

enum UserActionType {
  STATISTIQUES_TABLE
  STATISTIQUES_CARTOGRAPHIE
  STRUCTURES_CARTOGRAPHIE
  TYPE_PLACES_SPREADSHEET_EXPORT
  FINANCES_SPREADSHEET_EXPORT
  CONTROLE_QUALITE_SPREADSHEET_EXPORT
  STRUCTURE_SPREADSHEET_EXPORT
  STRUCTURE_PDF_EXPORT
  STATISTIQUES_SPREADSHEET_EXPORT
  STATISTIQUES_PDF_EXPORT

  @@schema("public")
}
