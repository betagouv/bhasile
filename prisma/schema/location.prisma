model Departement {
  numero               String              @id
  name                 String
  population           Int?
  structures           Structure[]
  structureVersions    StructureVersion[]
  roleDepartements     RoleDepartement[]
  userGrants           UserGrant[]
  emailPatternGrants   EmailPatternGrant[]
  regionAdministrative Region?             @relation(fields: [regionId], references: [id])
  regionId             Int?
  cpoms                CpomDepartement[]
  dnas                 Dna[]
  rmus                 Rmu[]

  @@schema("public")
}

model Region {
  id                 Int                 @id @default(autoincrement())
  name               String
  code               String
  departements       Departement[]
  cpoms              Cpom[]
  userGrants         UserGrant[]
  emailPatternGrants EmailPatternGrant[]

  @@schema("public")
}
