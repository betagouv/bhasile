model Structure {
  id                       Int                   @id @default(autoincrement())
  codeBhasile              String                @unique
  filiale                  String? // TODO: remove after first filling is complete, filiales via Operateur are connected in app and DB is backfilled
  type                     StructureType?
  departementAdministratif String? // TODO: migré sur StructureVersion — à retirer avec la relation departement (cascade Departement.structures)
  debutConvention          DateTime? // TODO: conservé pour la vue reporting. À supprimer quand les indicateurs qualité ne seront plus pertinents (après actualisation 1).
  finConvention            DateTime? // TODO: conservé pour la vue reporting. À supprimer quand les indicateurs qualité ne seront plus pertinents (après actualisation 1).
  creationDate             DateTime?
  fermetureDate            DateTime?
  date303                  DateTime?
  debutPeriodeAutorisation DateTime? // TODO: conservé pour la vue reporting. À supprimer quand les indicateurs qualité ne seront plus pertinents (après actualisation 1).
  finPeriodeAutorisation   DateTime? // TODO: conservé pour la vue reporting. À supprimer quand les indicateurs qualité ne seront plus pertinents (après actualisation 1).
  controles                Controle[]
  evaluations              Evaluation[]
  structureTypologies      StructureTypologie[] // TODO: remove after backfill of structure version
  actesAdministratifs      ActeAdministratif[]
  documentsFinanciers      DocumentFinancier[]
  cpomStructures           CpomStructure[]
  structureMillesimes      StructureMillesime[]
  budgets                  Budget[] // TODO: remove after backfill of structure version — via StructureMillesime uniquement
  indicateursFinanciers    IndicateurFinancier[] // TODO: remove after backfill of structure version
  operateur                Operateur?            @relation(fields: [operateurId], references: [id])
  operateurId              Int?
  forms                    Form[]
  departement              Departement?          @relation(fields: [departementAdministratif], references: [numero])
  userActions              UserAction[]
  userNotes                Note[]
  structureVersions        StructureVersion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@schema("public")
}

model StructureMillesime {
  id               Int        @id @default(autoincrement())
  structure        Structure? @relation(fields: [structureId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  structureId      Int?
  year             Int
  cpom             Boolean    @default(false) // temporary field, while we are not sure of existing cpoms
  operateurComment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([structureId, year])
  @@schema("public")
}

model StructureTypologie {
  id                               Int                             @id @default(autoincrement())
  structure                        Structure?                      @relation(fields: [structureId], references: [id], onDelete: Cascade, onUpdate: Cascade) // propriétaire live (années ≤2025 + détail toutes années)
  structureId                      Int?
  structureVersionTransformation   StructureVersionTransformation? @relation(fields: [structureVersionTransformationId], references: [id], onDelete: Cascade, onUpdate: Cascade) // ce que la transfo a déclaré : brouillon pendant la saisie, registre permanent après finalisation
  structureVersionTransformationId Int?
  year                             Int
  placesAutorisees                 Int?
  pmr                              Int?
  lgbt                             Int?
  fvvTeh                           Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([structureId, year])
  @@unique([structureVersionTransformationId, year])
  @@schema("public")
}

enum PublicType {
  TOUT_PUBLIC
  FAMILLE
  PERSONNES_ISOLEES

  @@schema("public")
}

enum StructureType {
  CADA
  HUDA
  CPH
  CAES
  PRAHDA
  NH

  @@schema("public")
}

view StructuresAggregates {
  id                          Int       @unique
  code_bhasile                String?
  dna_codes                   String?
  departement_administratif   String?
  departement                 String?
  region                      String?
  operateur                   String?
  structure_type              String?
  public                      String?
  latitude                    Decimal?
  longitude                   Decimal?
  updated_at                  DateTime?
  finalisation_status         String?
  finalisation_status_detail  String?
  places_autorisees_structure Int?
  dotation_derniere_annee     Float?

  @@map("structures_aggregates")
  @@schema("reporting")
}

view StructuresFilling {
  id                         Int       @unique
  code_bhasile               String?
  finalisation_status        String?
  finalisation_status_detail String?
  operateur                  String?
  structure_type             String?
  public                     String?
  region                     String?
  created_at                 DateTime?
  updated_at                 DateTime?

  @@map("structures_filling")
  @@schema("reporting")
}
