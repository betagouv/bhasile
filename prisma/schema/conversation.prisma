model Conversation {
  id                      Int                   @id @default(autoincrement())
  structureTarification   StructureTarification @relation(fields: [structureTarificationId], references: [id], onDelete: Restrict)
  structureTarificationId Int
  visibility              Visibility // fixée à la création
  messages                Message[]

  createdAt DateTime @default(now())

  @@unique([structureTarificationId, visibility])
  @@schema("public")
}

// Ajout seul : jamais modifié ni supprimé, sauf tagKey (voir docs/messagerie.md)
model Message {
  id             Int                            @id @default(autoincrement())
  conversation   Conversation                   @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  conversationId Int
  author         User                           @relation(fields: [authorId], references: [id], onDelete: Restrict)
  authorId       Int
  authorLevel    AuthorLevel // tiré des grants de l'auteur à l'écriture ; le plus large l'emporte
  text           String
  tagKey         String?
  receipts       MessageReceipt[]
  attachments    FileUpload[]
  notification   MessageNotification?
  notifiedUsers  MessageNotificationRecipient[]

  createdAt DateTime @default(now()) // horodatage serveur, fait foi

  @@index([conversationId, id])
  @@index([createdAt])
  @@schema("public")
}

// Première lecture d'un message par un utilisateur ; ajout seul
model MessageReceipt {
  message   Message @relation(fields: [messageId], references: [id], onDelete: Restrict)
  messageId Int
  user      User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId    Int

  createdAt DateTime @default(now())

  @@id([messageId, userId])
  @@index([userId])
  @@schema("public")
}

// Traitement des notifications d'un message terminé (même sans destinataire) ; son absence = message à notifier
model MessageNotification {
  message     Message   @relation(fields: [messageId], references: [id], onDelete: Restrict)
  messageId   Int       @id
  abandonedAt DateTime? // reprise abandonnée après 3 jours

  createdAt DateTime @default(now())

  @@schema("public")
}

// Un message signalé à un destinataire dans un mail accepté par Brevo ; un mail regroupe plusieurs messages
model MessageNotificationRecipient {
  message        Message @relation(fields: [messageId], references: [id], onDelete: Restrict)
  messageId      Int
  user           User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId         Int
  email          String
  brevoMessageId String // retrouve le mail dans les logs Brevo

  createdAt DateTime @default(now())

  @@id([messageId, userId])
  @@schema("public")
}

enum Visibility {
  SHARED
  AGENTS

  @@schema("public")
}

enum AuthorLevel {
  DEPARTEMENT
  REGION
  OPERATEUR

  @@schema("public")
}
