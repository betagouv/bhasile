model TarificationCampaign {
  id                     Int                     @id @default(autoincrement())
  year                   Int                     @unique
  structureTarifications StructureTarification[]

  createdAt DateTime @default(now())

  @@schema("public")
}

model StructureTarification {
  id            Int                  @id @default(autoincrement())
  structure     Structure            @relation(fields: [structureId], references: [id], onDelete: Restrict)
  structureId   Int
  campaign      TarificationCampaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  campaignId    Int
  conversations Conversation[]

  createdAt DateTime @default(now())

  @@unique([structureId, campaignId])
  @@index([campaignId])
  @@schema("public")
}
