model Perimetre {
  id                 Int                    @id @default(autoincrement())
  name               String
  isNational         Boolean                @default(false)
  operateur          Operateur?             @relation(fields: [operateurId], references: [id], onDelete: Restrict)
  operateurId        Int?
  regions            PerimetreRegion[]
  departements       PerimetreDepartement[]
  structures         PerimetreStructure[]
  userGrants         UserGrant[]
  emailPatternGrants EmailPatternGrant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([operateurId])
  @@schema("public")
}

model PerimetreRegion {
  perimetre   Perimetre @relation(fields: [perimetreId], references: [id], onDelete: Cascade)
  perimetreId Int
  region      Region    @relation(fields: [regionId], references: [id], onDelete: Cascade)
  regionId    Int

  @@id([perimetreId, regionId])
  @@index([regionId])
  @@schema("public")
}

model PerimetreDepartement {
  perimetre         Perimetre   @relation(fields: [perimetreId], references: [id], onDelete: Cascade)
  perimetreId       Int
  departement       Departement @relation(fields: [departementNumero], references: [numero], onDelete: Cascade)
  departementNumero String

  @@id([perimetreId, departementNumero])
  @@index([departementNumero])
  @@schema("public")
}

model PerimetreStructure {
  perimetre   Perimetre @relation(fields: [perimetreId], references: [id], onDelete: Cascade)
  perimetreId Int
  structure   Structure @relation(fields: [structureId], references: [id], onDelete: Cascade)
  structureId Int

  @@id([perimetreId, structureId])
  @@index([structureId])
  @@schema("public")
}

model UserGrant {
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int
  role        AccessRole
  perimetre   Perimetre  @relation(fields: [perimetreId], references: [id], onDelete: Restrict)
  perimetreId Int

  createdAt DateTime @default(now())

  @@id([userId, role, perimetreId])
  @@index([perimetreId])
  @@schema("public")
}

model EmailPatternGrant {
  emailPattern   EmailPattern @relation(fields: [emailPatternId], references: [id], onDelete: Cascade)
  emailPatternId Int
  role           AccessRole
  perimetre      Perimetre    @relation(fields: [perimetreId], references: [id], onDelete: Restrict)
  perimetreId    Int

  createdAt DateTime @default(now())

  @@id([emailPatternId, role, perimetreId])
  @@index([perimetreId])
  @@schema("public")
}

enum AccessRole {
  VIEWER
  EDITEUR
  ADMIN

  @@schema("public")
}
