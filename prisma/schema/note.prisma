model Note {
  id   Int    @id @default(autoincrement())
  text String

  parent   Note?  @relation("NoteToNote", fields: [parentId], references: [id], onDelete: Restrict)
  parentId Int?
  replies  Note[] @relation("NoteToNote")

  section            NoteSection?
  isOperateurVisible Boolean?

  structure   Structure? @relation(fields: [structureId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  structureId Int?
  cpom        Cpom?      @relation(fields: [cpomId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  cpomId      Int?

  author   User @relation(fields: [authorId], references: [id])
  authorId Int

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([structureId, section])
  @@index([cpomId, section])
  @@index([parentId])
  @@index([authorId])
  @@schema("public")
}

enum NoteSection {
  DESCRIPTION
  CALENDRIER
  TYPE_PLACES
  FINANCES
  CONTROLE
  ACTIVITE
  ACTES_ADMINISTRATIFS
  COMPOSITION
  GENERAL

  @@schema("public")
}
