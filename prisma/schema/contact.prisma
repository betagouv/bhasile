model Contact {
  id                 Int               @id @default(autoincrement())
  structureVersion   StructureVersion? @relation(fields: [structureVersionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  structureVersionId Int?
  prenom             String?
  nom                String?
  telephone          String?
  email              String?
  role               String?
  perimetre          String?
  operateur          Operateur?        @relation(fields: [operateurId], references: [id], onDelete: Cascade)
  operateurId        Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([structureVersionId])
  @@index([operateurId])
  @@schema("public")
}
