model Anomalie {
    id           Int                 @id @default(autoincrement())
    structure    Structure?          @relation(fields: [structureId], references: [id], onDelete: Cascade, onUpdate: Cascade)
    structureId  Int?
    definition   AnomalieDefinition? @relation(fields: [definitionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
    definitionId Int?
    commentaire  String?
    year         Int?
    isJustified  Boolean?
    createdAt    DateTime            @default(now())
    updatedAt    DateTime            @default(now()) @updatedAt

    @@schema("public")
}

model AnomalieDefinition {
    id          Int        @id @default(autoincrement())
    label       String
    fieldName   String
    divsToColor String[]
    anomalies   Anomalie[]

    @@schema("public")
}
