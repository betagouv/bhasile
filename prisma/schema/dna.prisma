model Dna {
  id                           Int                         @id @default(autoincrement())
  code                         String                      @unique
  activeInOfiiFileSince        DateTime? // date d'entrée dans le document Ofii
  inactiveInOfiiFileSince      DateTime? // date de sortie du document Ofii
  dnaStructures                DnaStructure[]
  activites                    Activite[]
  evenementsIndesirablesGraves EvenementIndesirableGrave[]

  // All fields below are directly coming from OFII file and not used after DNA is linked to a structure
  departement              Departement   @relation(fields: [departementAdministratif], references: [numero])
  departementAdministratif String
  operateur                Operateur     @relation(fields: [operateurId], references: [id])
  operateurId              Int
  type                     StructureType
  nom                      String
  nomOfii                  String
  directionTerritoriale    String

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@schema("public")
}

model DnaStructure {
  id                 Int               @id @default(autoincrement())
  dnaId              Int
  dna                Dna               @relation(fields: [dnaId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  structureVersion   StructureVersion? @relation(fields: [structureVersionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  structureVersionId Int?
  description        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([structureVersionId, dnaId])
  @@schema("public")
}

model Antenne {
  id                 Int               @id @default(autoincrement())
  structureVersion   StructureVersion? @relation(fields: [structureVersionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  structureVersionId Int?
  name               String?
  adresse            String?
  codePostal         String?
  commune            String?
  departement        String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @default(now()) @updatedAt

  @@schema("public")
}

model Finess {
  id                 Int               @id @default(autoincrement())
  code               String           @unique
  structureFinesses  StructureFiness[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @default(now()) @updatedAt

  @@schema("public")
}

model StructureFiness {
  id                 Int               @id @default(autoincrement())
  finessId           Int
  finess             Finess            @relation(fields: [finessId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  structureVersion   StructureVersion? @relation(fields: [structureVersionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  structureVersionId Int?
  description        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([structureVersionId, finessId])
  @@schema("public")
}
