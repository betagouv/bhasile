model StructureVersion {
  id          Int        @id @default(autoincrement())
  structureId Int?
  structure   Structure? @relation(fields: [structureId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  structureVersionTransformationId Int?                            @unique
  structureVersionTransformation   StructureVersionTransformation? @relation(fields: [structureVersionTransformationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  effectiveDate DateTime?

  placesAutorisees Int?

  adresseAdministrative    String?
  codePostalAdministratif  String?
  communeAdministrative    String?
  departementAdministratif String? // Correspond au département associé à l'adresse administrative versionnée (in app on bloque le fait de pouvoir le modifier)
  latitude                 Decimal?
  longitude                Decimal?
  nom                      String?
  lgbt                     Boolean? // TODO: remove after quality check between boolean and integer on adresses
  fvvTeh                   Boolean? // TODO: remove after quality check between boolean and integer on adresses
  public                   PublicType?
  notes                    String?
  nomOfii                  String?
  directionTerritoriale    String?

  departement Departement? @relation(fields: [departementAdministratif], references: [numero])

  contacts            Contact[]
  adresses            Adresse[]
  antennes            Antenne[]
  structureFinesses   StructureFiness[]
  dnaStructures       DnaStructure[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([structureId, effectiveDate])
  @@schema("public")
}
