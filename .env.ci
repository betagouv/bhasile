# Environnement du job e2e en CI. Aucune valeur sensible : la CI ne parle qu'à des
# services éphémères (Postgres et MinIO du runner). Copié en `.env` par le workflow
# AVANT le build, parce que les NEXT_PUBLIC_* sont inlinés à la compilation.

NEXT_URL=http://localhost:3000
NEXT_PUBLIC_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
E2E_BASE_URL=http://localhost:3000

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/test?schema=public"
DATABASE_POOL_MAX=10

# Doit rester factice : les traces Playwright uploadées en artefact public
# contiennent le cookie de session forgé avec ce secret.
AUTH_SECRET="ci-auth-secret-not-a-real-secret"

# Doit être une URL valide : /deconnexion/proconnect est prérendue au build.
PRO_CONNECT_ID="pro-connect-id"
PRO_CONNECT_SECRET="pro-connect-secret"
PRO_CONNECT_BASE_URL="https://pro-connect-base-url.example"
OPERATEUR_PASSWORDS="password"

# MinIO du runner : HTTP sur 9000, d'où S3_USE_SSL=0 et S3_PORT.
S3_URL="localhost"
S3_PORT=9000
S3_USE_SSL=0
S3_ACCESS="minioadmin"
S3_SECRET="minioadmin"
S3_BUCKET_NAME="bhasile-e2e"

# Vide : sinon `next build` tente un upload de source maps vers Sentry.
SENTRY_AUTH_TOKEN=""

REPORTING_SCHEMA="reporting"
DOCS_BUCKET_NAME="placedasile-docs"
OFII_CSV_NAME="structures_ofii.csv"
METABASE_SITE_URL="https://metabase.example"
METABASE_SECRET_KEY="metabase-key"
METABASE_DASHBOARD_ID=1
DEMARCHES_NUMERIQUES_TOKEN="demarches-numeriques-token"
NEXT_PUBLIC_BHASILE_CONTACT_EMAIL="contact@bhasile.beta.gouv.fr"
NEXT_PUBLIC_BHASILE_PHONE_NUMBERS="06 12 34 56 78"
NEXT_PUBLIC_MATOMO_URL="matomo-url"
NEXT_PUBLIC_MATOMO_SITE_ID="matomo-site-id"

SMALL_SEED=1
E2E_WORKERS=2

NEXT_PUBLIC_SHOW_RESSOURCES=true

# Millésimes de campagne et horloge figée : ils doivent bouger ensemble, sinon la
# suite teste une campagne fermée.
NEXT_PUBLIC_EMULATED_NOW="2026-06-15T12:00:00Z"
NEXT_PUBLIC_DOCUMENTS_FINANCIERS_OPEN_YEAR=2026
NEXT_PUBLIC_INDICATEUR_FINANCIER_CUTOFF_YEAR_AUTORISEE=2024
NEXT_PUBLIC_INDICATEUR_FINANCIER_CUTOFF_YEAR_SUBVENTIONNEE=2025
NEXT_PUBLIC_AUTORISEE_OPEN_YEAR=2026
NEXT_PUBLIC_SUBVENTIONNEE_OPEN_YEAR=2025
NEXT_PUBLIC_PLACES_VERSIONED_FROM_YEAR=2026
ACTUALISATION_YEAR=2026

# Désamorce guard-for-production.sh.
IS_PRODUCTION=false
CRON_ENABLED=false

TARIF_JOURNALIER_CIBLE={"CADA":{"idf":0,"horsIdf":0},"HUDA":{"idf":0,"horsIdf":0},"CPH":{"idf":0,"horsIdf":0},"CAES":{"idf":0,"horsIdf":0}}
